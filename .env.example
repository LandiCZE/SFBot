# Copy to .env (which is gitignored) and fill in.

# If SF_SERVER is set, the bot does a regular per-server login (SF_USERNAME is the
# character/account name on that server). If SF_SERVER is empty, the bot uses the
# SSO flow (login_sf_account) and expects SF_USERNAME to be your global S&F account
# email. For SSO, you must also set SF_CHARACTER to pick which character to play
# (match by character.name, case-insensitive) — if there's only one, it's picked.
SF_USERNAME=
SF_PASSWORD=
SF_SERVER=
SF_CHARACTER=

# true = decide + log, nothing is sent to the game.
DRY_RUN=true

# tracing filter — "info" is enough for day-1. Use "sf_bot=debug,sf_api=info" to
# see our module's debug lines without drowning in sf-api traffic.
RUST_LOG=info
